# Copy to .env and fill in. Never commit .env.

# --- App (public, bundled into the client) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Local database for migrations and SQL tests ---
# Portable Postgres (see CLAUDE.md) or `supabase start` (Docker)
DATABASE_URL=postgres://postgres:postgres@localhost:54329/fitlens_test

# --- Edge Functions (set with `supabase secrets set`, never in the client) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key
VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-5
AI_DAILY_LIMIT=30
FDC_API_KEY=

# --- Playwright ---
E2E_BASE_URL=http://localhost:8081
# A pre-provisioned test user (magic links cannot be clicked in CI)
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
